@model IEnumerable<MoEmpleado>
@{
    ViewData["Title"] = "Personal";
}

<link rel="stylesheet" href="~/css/Estilos/cssPersonal.css" asp-append-version="true" />

<div class="container-fluid col-12 col-md-9 col-xl-8 mx-auto">
    <div class="d-flex align-items-center mt-4">
        <a asp-controller="Inicio" asp-action="Index" class="btn btn-secondary btn-sm me-3 px-2 py-1">
            <i class="fa-solid fa-arrow-left-long"></i>
        </a>
        <h2 class="mb-1">Gestión de Personal</h2>
    </div>

    <div class="d-flex flex-wrap mt-4 gap-2">
        <div class="col-4 col-md-3 order-1 order-md-0">
            <div class="input-group">
                <label class="input-group-text" for="ddlPersonal">Ver:</label>
                <select id="ddlPersonal" class="form-select">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
        <div class="col-12 col-md-6 mx-auto order-0 order-md-1">
            <input id="txtBuscarPersonal" type="text" class="form-control" placeholder="Buscar empleado..." />
        </div>
        <button id="btnAgregar" class="btn btn-primary btn-md ms-auto order-2" onclick="fnMostrarAgregarEmpleado()">
            <i class="fa-solid fa-circle-plus"></i>
            <span class="ms-1">Agregar</span>
        </button>
    </div>

    <div class="table-responsive mt-2">
        <table id="tblPersonal" class="table table-bordered table-striped text-center">
            <thead class="table-dark text-center">
                <tr>
                    <th>Id</th>
                    <th>Usuario</th>
                    <th>Departamento</th>
                    <th>No. Personal</th>
                    <th>Permisos</th>
                    <th>Admin</th>
                    <th>Alta</th>
                    <th>Últ. Modificación</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model)
                {
                    <tr>
                        <td>@empleado.NId</td>
                        <td>@empleado.SUsuario</td>
                        <td>@empleado.SDep</td>
                        <td>@empleado.NNoPerson</td>
                        <td>@empleado.CPermisos</td>
                        <td>@(empleado.BAdmin ? "Sí" : "No")</td>
                        <td>@empleado.DFAlta.ToString("dd/MM/yyyy")</td>
                        <td>@empleado.DFUltModif.ToString("dd/MM/yyyy")</td>
                        <td>@empleado.CIndActivo</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm" title="Ver" onclick="fnVerEmpleado(@empleado.NId, '@empleado.SUsuario')">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" title="Editar" onclick="fnEditarEmpleado(@empleado.NId)">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- modal para ver la imagen del personal -->
<div class="modal fade" id="mdlVerfotoPersonal" tabindex="-1" aria-labelledby="hVerFoto" aria-hidden="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hVerFoto">Fotografía del empleado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imgVerFoto" src="" alt="Foto del empleado" class="img-fluid w-100 h-100 rounded border" />
                <div class="mt-2">
                    <span id="spMatriculaVerFoto" class="fw-bold"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar empleado -->
<div class="modal fade" id="mdlAgregarEmpleado" tabindex="-1" aria-labelledby="hAgregarEmpleado" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="frmAgregarEmpleado" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="hAgregarEmpleado">Agregar Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Usuario</label>
                            <input type="text" name="SUsuario" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Departamento</label>
                            <input type="text" name="SDep" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">No. Personal</label>
                            <input type="number" name="NNoPerson" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Permisos</label>
                            <input type="text" name="CPermisos" maxlength="1" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">¿Admin?</label>
                            <select name="BAdmin" class="form-select" required>
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Fotografía</label>
                            <input type="file" name="Foto" accept="image/*" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/Scripts/jsPersonal.js" asp-append-version="true"></script>
}
