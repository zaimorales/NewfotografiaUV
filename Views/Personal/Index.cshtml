@model IEnumerable<MoEmpleado>
@{
    ViewData["Title"] = "Personal";
}

<link rel="stylesheet" href="~/css/Estilos/cssPersonal.css" asp-append-version="true" />

<div class="container-fluid col-12 col-md-9 col-xl-8 mx-auto">
    <div class="d-flex align-items-center mt-4">
        <a asp-controller="Inicio" asp-action="Index" class="btn btn-secondary btn-sm me-3 px-2 py-1">
            <i class="fa-solid fa-arrow-left-long"></i>
        </a>
        <h2 class="mb-1">Gestión de Personal</h2>
    </div>

    <div class="d-flex flex-wrap mt-4 gap-2">
        <div class="col-4 col-md-3 order-1 order-md-0">
            <div class="input-group">
                <label class="input-group-text" for="ddlPersonal">Ver:</label>
                <select id="ddlPersonal" class="form-select">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
        <div class="col-12 col-md-6 mx-auto order-0 order-md-1">
            <input id="txtBuscarPersonal" type="text" class="form-control" placeholder="Buscar empleado..." />
        </div>
        <button id="btnAgregar" class="btn btn-primary btn-md ms-auto order-2" onclick="fnMostrarAgregarEmpleado()">
            <i class="fa-solid fa-circle-plus"></i>
            <span class="ms-1">Agregar</span>
        </button>
    </div>

    <div class="table-responsive mt-2">
        <table id="tblPersonal" class="table table-bordered table-striped text-center">
            <thead class="table-dark text-center">
                <tr>
                    <th>Id</th>
                    <th>Usuario</th>
                    <th>Departamento</th>
                    <th>No. Personal</th>
                    <th>Permisos</th>
                    <th>Admin</th>
                    <th>Alta</th>
                    <th>Últ. Modificación</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model)
                {
                    <tr>
                        <td>@empleado.NId</td>
                        <td>@empleado.SUsuario</td>
                        <td>@empleado.SDep</td>
                        <td>@empleado.NNoPerson</td>
                        <td>@empleado.CPermisos</td>
                        <td>@(empleado.BAdmin ? "Sí" : "No")</td>
                        <td>@empleado.DFAlta.ToString("dd/MM/yyyy")</td>
                        <td>@empleado.DFUltModif.ToString("dd/MM/yyyy")</td>
                        <td>@empleado.CIndActivo</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm border-0" title="Ver" 
                                onclick="fnVerEmpleado(@empleado.NId, '@empleado.SUsuario')">
                                <i class="fa-solid fa-eye"></i>
                            </button>

                            <button class="btn btn-outline-secondary btn-sm border-0" title="Editar" 
                                onclick="fnEditarEmpleado(@empleado.NId, '@empleado.SUsuario')">
                                <i class="fa-solid fa-pen"></i>
                            </button>

                            <button class="btn btn-outline-danger btn-sm border-0" title="Eliminar" 
                                onclick="fnEliminarEmpleado(@empleado.NId, '@empleado.SUsuario')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- modal para ver la imagen del personal -->
<div class="modal fade" id="mdlVerfotoPersonal" tabindex="-1" aria-labelledby="hVerFoto" aria-hidden="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hVerFoto">Fotografía del empleado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imgVerFoto" src="" alt="Foto del empleado" class="img-fluid w-100 h-100 rounded border" />
                <div class="mt-2">
                    <span id="spMatriculaVerFoto" class="fw-bold"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- modal de alertas-->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="toastMensaje" class="toast align-items-center text-white bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastText">
                Empleado agregado correctamente
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Modal para agregar empleado -->
<div class="modal fade" id="mdlAgregarEmpleado" tabindex="-1" aria-labelledby="hAgregarEmpleado" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <form id="frmAgregarEmpleado" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
                <input type="file" id="txtFotosEmpleado" multiple accept=".jpg,image/jpeg" class="d-none" onchange="empleado_OnFilesSelected(this)">

                <div id="divDropEmpleado"
                     class="position-absolute align-items-center justify-content-center bg-secondary bg-opacity-50 text-white fs-4"
                     style="display: none; inset: 0; z-index: 2000;">
                    Suelte las imágenes aquí...
                </div>

                <div class="modal-header">
                    <h5 class="modal-title" id="hAgregarEmpleado">Agregar Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">

                        <!-- CAMPOS DEL EMPLEADO -->
                        <div class="col-md-6">
                            
                            <label for="inputUsuario" class="form-label">Usuario</label>
                            <input type="text" name="SUsuario" class="form-control" id="inputUsuario" maxlength="50" required />
                            <small class="text-muted">
                                <span id="cntUsuario">0</span>/50 caracteres
                            </small>
                            <div class="invalid-feedback">
                                Porfavor agrega un nombre de usuario.
                            </div>
                            
                        </div>

                        <div class="col-md-6">

                            <label for="inputDep" class="form-label">Departamento</label>
                            <input type="text" name="SDep" class="form-control" id="inputDep" maxlength="100" required />
                            <small class="text-muted">
                                <span id="cntDep">0</span>/100 caracteres
                            </small>
                            <div class="invalid-feedback">
                                Porfavor agrega un nombre departamento.
                            </div>

                        </div>

                        <div class="col-md-4">

                            <label for="validationCustom03" class="form-label">No. Personal</label>
                            <input type="text" name="NNoPerson" class="form-control" id="validationCustom03" 
                            pattern="[0-9]+" inputmode="numeric" maxlength="10"
                            oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                            <div class="invalid-feedback">
                                Porfavor agrega el número de personal.
                            </div>

                        </div>

                        <div class="col-md-4">

                            <label for="validationCustom03" class="form-label">Permisos</label>
                            <input type="text" name="CPermisos" maxlength="1" class="form-control" required />
                            <div class="invalid-feedback">
                                Porfavor agrega los permisos.
                            </div>

                        </div>

                        <div class="col-md-4">

                            <label for="validationCustom04" class="form-label">¿Admin?</label>
                            <select name="BAdmin" class="form-select" id="validationCustom04" required>
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                            <div class="invalid-feedback">
                                Porfavor elije una opcion.
                            </div>

                        </div>
                        <!-- INPUT OCULTO: este es el que viaja al backend -->
                        <input type="file" id="fotoEmpleadoSeleccionada" name="Foto" class="d-none" />

                        <!-- INPUT REAL QUE PERMITE SUBIR MULTIPLES FOTOS -->
                        <input type="file" id="txtFotosEmpleado" multiple accept=".jpg,image/jpeg" class="d-none"
                               onchange="empleado_OnFilesSelected(this)">

                        <!-- Área inicial de carga -->
                        <div id="divInfoEmpleado" class="text-center mt-4">
                            <div class="m-auto">
                                <div class="card m-auto text-dark border-dark opacity-50" style="width: 160px; height: 160px; cursor: pointer;" onclick="empleado_openFileInput()">
                                    <i class="fa-solid fa-user m-auto" style="font-size: 100px; "></i>
                                </div>
                            </div>

                            <div class="mt-2 opacity-75">
                                <p class="fw-bold mb-1">Suba las fotos del empleado</p>
                                <p class="mb-1">Puede seleccionar una o más imágenes JPG.</p>
                                <p class="mb-1">Arrastre y suelte aquí,</p>
                                <p class="mb-1">o haga clic para elegir archivos.</p>
                                <hr class="mt-3 mb-2 opacity-25">
                                <p class="mb-1"><strong>Formato permitido:</strong> JPG</p>
                                <p class="mb-1"><strong>Nombre de archivo:</strong> [MATRÍCULA].jpg</p>
                                <p class="mb-1"><strong>Ejemplo:</strong> S23021478.jpg</p>
                            </div>
                        </div>

                        <!-- CONTENEDOR PRINCIPAL + MINIATURAS -->
                        <div id="divContenedorFotosEmpleado" class="text-center d-none mt-4">
                            <!-- Foto grande seleccionada -->
                            <div class="ratio ratio-1x1 m-auto" style="max-width: 300px;">
                                <img id="imgEmpleadoPrincipal" src="" class="img-fluid">
                            </div>

                            <div class="mt-2 d-flex justify-content-center align-items-center gap-2">
                                <span id="spEmpleadoFotoNombre" class="fs-5 fw-bold">Foto seleccionada</span>
                            </div>

                            <!-- Miniaturas -->
                            <div id="divMiniaturasEmpleado"
                                 class="d-flex flex-row flex-wrap justify-content-center gap-2 mt-3">

                                <!-- Botón agregar fotos -->
                                <div id="divAddFoto" class="d-flex align-items-center"
                                     style="width: 60px; height: 60px; padding: .7rem;">
                                    <label for="txtFotosEmpleado"
                                           class="btn btn-primary p-0 w-100 h-100 rounded-circle d-flex justify-content-center align-items-center">
                                        <i class="fa-solid fa-plus fs-5"></i>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para imágenes duplicadas -->
<div class="modal fade" id="mdlImagenDuplicada" tabindex="-1" aria-labelledby="hImagenDuplicada"
     aria-hidden="true" data-bs-backdrop="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hImagenDuplicada">Imagen duplicada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p>Ya existe una imagen llamada <span class="fw-bold" id="spNombreImagenDuplicada"></span>.</p>
                <div class="d-flex justify-content-center align-items-center gap-3 mb-3">
                    <div>
                        <div class="small text-muted">Actual</div>
                        <img id="imgDuplicadaActual" src="" alt="Actual"
                             style="min-width: 120px; max-width: 120px; min-height: 120px; max-height: 120px;">
                    </div>
                    <div>
                        <div class="small text-muted">Nueva</div>
                        <img id="imgDuplicadaNueva" src="" alt="Nueva"
                             style="min-width: 120px; max-width: 120px; min-height: 120px; max-height: 120px;">
                    </div>
                </div>
                <p class="mb-1">¿Qué deseas hacer?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="btnReemplazar">Reemplazar</button>
                <button type="button" class="btn btn-secondary" id="btnOmitir">Omitir</button>
                <button type="button" class="btn btn-outline-secondary" id="btnCancelarCarga">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para editar foto de empleado -->
<div class="modal fade" id="mdlEditarFotoEmpleado" tabindex="-1" aria-labelledby="hEditarFotoEmpleado"
     aria-hidden="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hEditarFotoEmpleado">Editar Fotografía del Empleado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row text-center">

                    <!-- FOTO ACTUAL -->
                    <div class="col-md-6">
                        <p class="fw-bold mb-2">Foto actual</p>
                        <img id="imgEditarFotoEmpleado"
                             class="img-fluid rounded border"
                             style="max-height: 250px; object-fit: cover;" />
                    </div>

                    <!-- FOTO NUEVA -->
                    <div class="col-md-6">
                        <p class="fw-bold mb-2">Nueva foto</p>
                        <img id="imgPreviewNuevaFoto"
                             class="img-fluid rounded border mb-2 d-none"
                             style="max-height: 250px; object-fit: cover;" />

                        <input type="file"
                               id="txtNuevaFotoEmpleado"
                               accept=".jpg,image/jpeg"
                               class="form-control" />

                    </div>

                </div>
                <div class="text-center mt-3">
                    <span id="spMatriculaEditarFotoEmpleado" class="fw-bold"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                <button type="button" 
                    class="btn btn-primary" 
                    onclick="editarEmpleado_GuardarFoto()">
                    Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Modal para eliminar empleado --> 
<div class="modal fade" id="mdlConfirmarEliminarEmpleado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    ¿Deseas eliminar al empleado
                    <strong id="spEmpleadoEliminar"></strong>?
                </p>
                <p class="text-muted mt-2 mb-0">
                    Esta acción desactivará al empleado.
                </p>
                <div class="alert alert-danger d-none mt-3" id="alertEliminarEmpleado"></div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminarEmpleado">
                    Eliminar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Scripts/jsPersonal.js" asp-append-version="true"></script>
    
}
